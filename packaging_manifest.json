{
  "task_id": "neural-text-compression",
  "version": "0.3.0",
  "files": {
    "read_only": [
      "README.md",
      "task.md",
      "metadata.json",
      "packaging_manifest.json",
      "evaluator.py",
      "run_evaluator.sh",
      "setup_data.py",
      "lib/__init__.py",
      "lib/arithmetic_coding.py",
      "lib/utils.py",
      "baseline/noop.py",
      "baseline/ppm.py",
      "baseline/neural.py",
      "instances/sample/*",
      "instances/dev/*",
      "instances/train/*",
      "instances/hidden/*",
      "tests/*",
      "validation_report.md",
      "frontier_eval/*"
    ],
    "agent_editable": [
      "solution_template/model.py",
      "solution_template/compress.py",
      "solution_template/decompress.py",
      "solution_template/*.py"
    ]
  },
  "baselines": {
    "noop": "baseline/noop.py",
    "ppm": "baseline/ppm.py",
    "neural": "baseline/neural.py",
    "default": "baseline/ppm.py"
  },
  "entry_points": {
    "evaluator": "bash run_evaluator.sh",
    "evaluator_dev": "bash run_evaluator.sh --mode dev",
    "evaluator_sample": "bash run_evaluator.sh --mode sample",
    "frontier_eng": "python -m frontier_eval task=unified task.benchmark=AIInfra/NeuralTextCompression",
    "setup": "python setup_data.py"
  }
}
