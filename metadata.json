{
  "task_id": "neural-text-compression",
  "task_name": "Text Compression Optimization",
  "category": "ai_ml_infra",
  "difficulty": "hard",
  "description": "Optimize a text compressor to minimize compressed size of Wikipedia text chunks. The agent iteratively improves the prediction model; a read-only arithmetic coder converts predictions into bits.",
  "scoring": {
    "metric": "compression_ratio",
    "formula": "original_size / (compressed_size + decompressor_code_size)",
    "higher_is_better": true,
    "compressed_size": "output of compress.py (bitstream + any serialized model weights)",
    "decompressor_code_size": "total bytes of solution_template/*.py"
  },
  "feasibility": {
    "check": "byte-exact decompression",
    "timeout_per_chunk_sec": 600,
    "timeout_adjustable": "EVAL_TIMEOUT env var"
  },
  "baselines": {
    "noop": {"score": 0.98, "description": "uniform distribution"},
    "ppm": {"score": 2.3, "description": "order-8 adaptive PPM (default)"},
    "neural": {"score": 1.5, "description": "GRU with online SGD"}
  },
  "estimated_ceiling_score": 9.4,
  "budget_recommended": 100,
  "requires_gpu": false,
  "requires_network": false,
  "python_version": ">=3.10",
  "dependencies": ["numpy", "torch"]
}
